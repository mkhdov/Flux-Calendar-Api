# Required app images (replace with your GitLab image tags)
CONFIG_SERVER_IMAGE=registry.gitlab.com/your-group/flux-config-server:latest
DISCOVERY_IMAGE=registry.gitlab.com/your-group/discovery-service:latest
GATEWAY_IMAGE=registry.gitlab.com/your-group/gateway-service:latest
USER_MANAGEMENT_IMAGE=registry.gitlab.com/your-group/user-management-service:latest
CALENDAR_IMAGE=registry.gitlab.com/your-group/calendars-service:latest
FRONTEND_IMAGE=registry.gitlab.com/your-group/flux-frontend:latest

# Optional infra image overrides
REDIS_IMAGE=redis:7-alpine
ZOOKEEPER_IMAGE=confluentinc/cp-zookeeper:7.5.0
KAFKA_IMAGE=confluentinc/cp-kafka:7.5.0
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0.0
POSTGRES_IMAGE=postgres:16

# Ingress
K8S_NAMESPACE=flux
INGRESS_CLASS=nginx
WEB_HOST=flux.local
API_HOST=api.flux.local
FRONTEND_CONTAINER_PORT=80
